# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PRESSURE_MAX_HEAP_MB=420
PRESSURE_MAX_RSS_MB=768
APP_NAME="API Monitoring"
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000/api

# ── Databases ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_monitoring
# PostgreSQL socket address family: 0 = Node default, 4 = IPv4, 6 = IPv6.
# Keep 0 in production until connectivity is tested on the production host.
# Use 6 locally only on networks that require IPv6/NAT64 for the database endpoint.
DB_FAMILY=0
# Primary pool. PER PROCESS — multiply by your PM2 instance counts before
# comparing against the provider's connection limit. See
# docs/ingestion-performance-forensics.md for the fleet-wide budget table.
# DB_POOL_MAX=20
# DB_POOL_MIN=1
# Optional. Leave unset to auto-enable SSL for Supabase hosts and sslmode=require URLs.
# DB_SSL_ENABLED=
# DB_SSL_REJECT_UNAUTHORIZED=false

# Log Database (optional, for separate analytics DB)
# For IPv4 networks, use this log project's Supabase Connect > Session pooler URL
# (port 5432 and its pooler username). Direct db.<project>.supabase.co hosts may
# resolve only to IPv6; DNS_RESULT_ORDER=ipv4first cannot fix that.
# Leave LOG_DB_REPLICA unset unless you have a separate reachable replica.
# LOG_DB_PRIMARY=
# LOG_DB_REPLICA=
# Log DB READ pool (dashboards, analytics, migrations). Ingest WRITES use the
# dedicated INGESTION_WRITE_POOL_SIZE pool instead, so this can be tuned for
# read concurrency without affecting ingestion write admission.
# LOG_POOL_MAX=20
# LOG_POOL_MIN=5
# LOG_QUERY_TIMEOUT=30000
# LOG_RETRIES=3
# Optional. Leave unset to auto-enable SSL for Supabase hosts and sslmode=require URLs.
# LOG_DB_SSL_ENABLED=
# LOG_DB_SSL_REJECT_UNAUTHORIZED=false
# true: worker startup applies unattended-safe migrations. Migrations marked
# requires-operator-drain remain pending and must be run with the explicit Log
# DB migration command during a real writer-drained maintenance window.
# false: worker startup applies no Log DB migrations.
# LOG_DB_AUTO_MIGRATE=true

# ClickHouse (optional)
# CLICKHOUSE_URL=

# ── Redis ───────────────────────────────────────────────────────────────
# Redis is optional by default; set true only when cache availability must gate readiness.
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379

# ── Security ────────────────────────────────────────────────────────────
# Generate each value independently with: openssl rand -hex 32
# IMPORTANT: JWT_SECRET, JWT_REFRESH_SECRET, COOKIE_SECRET, and ENCRYPTION_KEY
# MUST be distinct. The application refuses to start if any two are equal.
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-in-production-use-openssl-rand-hex-32
COOKIE_SECRET=change-me-in-production-use-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-32-characters-exactly!!

# CORS: comma-separated allowed origins (production only)
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Shared auth callback endpoints. Register these exact API URLs in provider consoles.
OIDC_CALLBACK_URL=http://localhost:3000/auth/sso/callback
SOCIAL_LOGIN_CALLBACK_URL=http://localhost:3000/auth/login/social/callback
IDENTITY_LINK_CALLBACK_URL=http://localhost:3000/auth/identity-providers/callback

# ── Email / SMTP ────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=API Monitoring

# Social OAuth / identity linking (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Provider-console references:
# Google social login callback:     http://localhost:3000/auth/login/social/callback
# Google identity link callback:    http://localhost:3000/auth/identity-providers/callback
# GitHub social login callback:     http://localhost:3000/auth/login/social/callback
# GitHub identity link callback:    http://localhost:3000/auth/identity-providers/callback
# Microsoft social login callback:  http://localhost:3000/auth/login/social/callback
# Microsoft identity link callback: http://localhost:3000/auth/identity-providers/callback

# SAML Service Provider (optional)
# SAML_SP_ENTITY_ID=http://localhost:3000/auth/saml/metadata
# SAML_SP_ACS_URL=http://localhost:3000/auth/saml/acs
# SAML_SP_SLO_URL=http://localhost:3000/auth/saml/slo
# SAML_ENFORCE_HTTPS=true
# SAML_REQUIRE_SIGNED_ASSERTIONS=true
# SAML_REQUIRE_SIGNED_RESPONSES=true
# SAML_ACCEPTED_CLOCK_SKEW_MS=180000
# SAML_MAX_ASSERTION_AGE_MS=300000
# SAML_REQUEST_ID_TTL_MS=600000
# SAML_ASSERTION_REPLAY_TTL_MS=600000
# SAML_SP_PRIVATE_KEY=
# SAML_SP_CERTIFICATE=

# WebAuthn (optional)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=API Monitoring

# ── AI reliability assistant (optional; fail-closed) ─────────────────────
# Both AI_ENABLED=true and OPENAI_API_KEY are required to enable provider calls.
# AI_ENABLED=false
# OPENAI_API_KEY=
# AI_PRIMARY_MODEL=gpt-4o-mini
# AI_FALLBACK_MODEL=gpt-4o
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_PROVIDER_TIMEOUT_MS=30000
# AI_PROVIDER_MAX_RETRIES=2
# AI_CIRCUIT_FAILURE_THRESHOLD=5
# AI_CIRCUIT_RESET_MS=30000
# AI_MAX_INPUT_CHARS=250000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_RETRIEVAL_CHUNKS=8
# AI_CACHE_TTL_SECONDS=3600
# AI_RATE_LIMIT_PER_MINUTE=20
# AI_MAX_CONCURRENT_JOBS_PER_TENANT=5
# AI_MAX_CONCURRENT_CHAT_PER_TENANT=10

# == Ingestion pipeline (API path tunables) ==================================
# All optional; safe defaults applied in src/config/env.ts.
# INGESTION_MAX_BATCH_SIZE=1000
# INGESTION_DEFAULT_RATE_PER_SECOND=1000
# INGESTION_DEFAULT_RATE_PER_MINUTE=10000
# INGESTION_BACKPRESSURE_HIGH_WATER=100000
# INGESTION_BACKPRESSURE_CRITICAL_WATER=250000
# INGESTION_REPLAY_MAX_EVENTS=10000
# INGESTION_RATE_BUCKET_TTL_MS=300000
# INGESTION_RATE_BUCKET_SWEEP_MS=60000
# INGESTION_ENDPOINT=https://api.pulse.io/api/v1/ingest

# == Ingestion worker tier (v2) =============================================
# General lane (fast signals): error/message/request/span/metric/log/cron_checkin
# INGESTION_GENERAL_WORKERS=4
# INGESTION_GENERAL_CONCURRENCY=8
# INGESTION_GENERAL_BATCH_SIZE=50
# Specialized lane (heavy signals): profile/replay/trace
# INGESTION_SPECIALIZED_WORKERS=2
# INGESTION_SPECIALIZED_CONCURRENCY=4
# INGESTION_SPECIALIZED_BATCH_SIZE=10
# INGESTION_VISIBILITY_TIMEOUT_MS=300000
# INGESTION_SPECIALIZED_VISIBILITY_TIMEOUT_MS=600000
# INGESTION_POLL_MS=25
# INGESTION_IDLE_POLL_MS=500
# INGESTION_DB_POOL_SIZE=20

# == Ingest write admission (DB concurrency ceiling) ========================
# Dedicated Log DB pool for ingest writes, isolated from LOG_POOL_MAX so API
# read bursts and ingest write bursts cannot starve each other.
# INGESTION_WRITE_POOL_SIZE=20
# Hard ceiling on CONCURRENT ingest transactions. Clamped at runtime to
# (INGESTION_WRITE_POOL_SIZE - reserve), so it can under-use the pool but can
# never oversubscribe it. Raise this and the pool size TOGETHER.
# INGESTION_WRITE_CONCURRENCY=16
# Per-transaction statement timeout for ingest writes. MUST be < than
# INGESTION_JOB_EXPIRE_SECONDS or the process refuses to boot: pg-boss
# re-delivers an expired job without cancelling the running transaction.
# INGESTION_LOG_DB_STATEMENT_TIMEOUT_MS=60000
# Gateway backpressure queue-depth probe cache TTL.
# INGESTION_QUEUE_DEPTH_CACHE_MS=3000
# INGESTION_RETRY_INTERVAL_MS=15000
# INGESTION_MAINTENANCE_INTERVAL_MS=21600000
# INGESTION_COMPLETED_RETENTION_MS=3600000

# == Usage counter (three-tier) =============================================
# INGESTION_USAGE_FLUSH_MS=30000
# INGESTION_USAGE_BUFFER_LIMIT=10000

# == TimescaleDB logging database (operational metrics + audit) =============
# Separate instance from DATABASE_URL. When unset, logging degrades to no-ops
# and admin logs still land in the primary DB (ingestion_admin_logs).
# TIMESCALEDB_URL=postgresql://user:pass@localhost:5433/pulse_logs
# INGESTION_LOG_DB_POOL_SIZE=5
# INGESTION_ADMIN_LOG_BUFFER_SIZE=100
# INGESTION_ADMIN_LOG_FLUSH_MS=5000
