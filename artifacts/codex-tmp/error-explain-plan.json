    {
      "label": "insert:alert_runtime_idempotency_keys",
      "statement": "WITH input AS ( SELECT * FROM UNNEST( $1::uuid[], $2::uuid[], $3::text[], $4::text[], $5::text[], $6::logdb_severity[], $7::boolean[], $8::jsonb[], $9::timestamptz[] ) AS t(organization_id, project_id, environment, signal_kind, event_id, severity, fast_path, attributes, occurred_at) ), reserved AS ( INSERT INTO alert_runtime_idempotency_keys (namespace, organization_id, idempotency_key) SELECT 'telemetry_outbox', organization_id, signal_kind || ':' || event_id FROM input ON CONFLICT DO NOTHING RETURNING organization_id, idempotency_key ), inserted AS ( INSERT INTO telemetry_outbox ( organization_id, project_id, environment, signal_kind, event_id, severity, fast_path, attributes, occurred_at ) SELECT t.organization_id, t.project_id, t.environment, t.signal_kind, t.event_id, t.severity, t.fast_path, t.attributes, t.occurred_at FROM input t JOIN reserved r ON r.organization_id = t.organization_id AND r.idempotency_key = t.signal_kind || ':' || t.event_id ON CONFLICT DO NOTHING RETURNING id ) SELECT COUNT(*)::int AS count FROM inserted",
