{
  "name": "pulsiv",
  "version": "3.1.0",
  "description": "See [docs/enterprise-auth-implementation-plan.md](docs/enterprise-auth-implementation-plan.md) for the enterprise-grade backend remediation plan.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:workers": "tsx watch src/shared/workers/main.ts",
    "dev:alert:workers": "tsx watch src/shared/workers/alert-workers-main.ts",
    "dev:ingestion": "tsx watch src/shared/workers/ingestion-worker-main.ts",
    "dev:analytics": "tsx watch src/shared/workers/analytics-worker-main.ts",
    "dev:cron": "tsx watch src/shared/workers/cron.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:prod": "cross-env NODE_ENV=production PROCESS_ROLE=api node --max-old-space-size=512 dist/main.js",
    "start:workers": "cross-env PROCESS_ROLE=worker node dist/shared/workers/main.js",
    "start:alert:workers": "cross-env PROCESS_ROLE=alert-worker node dist/shared/workers/alert-workers-main.js",
    "start:ingestion": "cross-env PROCESS_ROLE=ingestion node dist/shared/workers/ingestion-worker-main.js",
    "start:analytics": "cross-env PROCESS_ROLE=analytics node dist/shared/workers/analytics-worker-main.js",
    "start:cron": "cross-env PROCESS_ROLE=cron node dist/shared/workers/cron.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs --env production",
    "pm2:start:workers": "npx pm2 start ecosystem.config.cjs --only background-workers,ingestion-workers,analytics-workers",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs --env production",
    "pm2:reload": "npx pm2 startOrReload ecosystem.config.cjs --env production",
    "pm2:delete": "npx pm2 delete ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:monit": "npx pm2 monit",
    "pm2:status": "npx pm2 list",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/setup-db.ts",
    "db:migrate:canonical": "tsx scripts/setup-db.ts --migrations-profile canonical",
    "db:migrate:draft": "tsx scripts/setup-db.ts --migrations-profile draft",
    "db:migrate:folder": "tsx scripts/run-canonical-folder.ts",
    "db:primary:draft": "tsx scripts/run-primary-draft-folder.ts",
    "db:migrate:logdb": "tsx scripts/migrate-logdb.ts",
    "db:create:logdb": "tsx scripts/migrate-logdb.ts",
    "db:create:primary": "tsx scripts/create-primary-db.ts",
    "db:seed:primary": "tsx scripts/run-primary-seeders.ts",
    "db:truncate:primary": "tsx scripts/truncate-primary-db.ts",
    "db:drop:primary": "tsx scripts/drop-primary-db.ts",
    "db:reset:logdb": "tsx scripts/reset-logdb.ts",
    "db:recreate": "tsx scripts/recreate-db.ts",
    "db:seed": "tsx scripts/run-primary-seeders.ts",
    "db:seed:billing": "tsx scripts/seed-billing-plans.ts",
    "billing:preview": "node scripts/generate-billing-preview.cjs",
    "email:preview": "tsx scripts/preview-emails.ts",
    "db:indexes": "tsx scripts/add-indexes.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clickhouse/client": "^1.18.2",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/passport": "^3.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.7",
    "openai": "^6.33.0",
    "openid-client": "^6.8.4",
    "opossum": "^9.0.0",
    "otpauth": "^9.5.0",
    "p-limit": "^7.3.0",
    "p-map": "^7.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "svix": "^1.90.0",
    "ts-morph": "^28.0.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/clickhouse": "^11.13.0",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APILogix/pulse.git"
  },
  "bugs": {
    "url": "https://github.com/APILogix/pulse/issues"
  },
  "homepage": "https://github.com/APILogix/pulse#readme"
}