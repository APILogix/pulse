{
  "name": "pulsiv",
  "version": "3.2.0",
  "description": "See [docs/enterprise-auth-implementation-plan.md](docs/enterprise-auth-implementation-plan.md) for the enterprise-grade backend remediation plan.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "ev": "tsx watch src/main.ts",
    "dev:workers": "tsx watch src/shared/workers/main.ts",
    "dev:alert:workers": "tsx watch src/shared/workers/alert-workers-main.ts",
    "dev:ingestion": "tsx watch src/shared/workers/ingestion-worker-main.ts",
    "dev:analytics": "tsx watch src/shared/workers/analytics-worker-main.ts",
    "dev:cron": "tsx watch src/shared/workers/cron.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:prod": "cross-env NODE_ENV=production PROCESS_ROLE=api node --max-old-space-size=512 dist/main.js",
    "start:workers": "cross-env PROCESS_ROLE=worker node dist/shared/workers/main.js",
    "start:alert:workers": "cross-env PROCESS_ROLE=alert-worker node dist/shared/workers/alert-workers-main.js",
    "start:ingestion": "cross-env PROCESS_ROLE=ingestion node dist/shared/workers/ingestion-worker-main.js",
    "start:analytics": "cross-env PROCESS_ROLE=analytics node dist/shared/workers/analytics-worker-main.js",
    "start:cron": "cross-env PROCESS_ROLE=cron node dist/shared/workers/cron.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs --env production",
    "pm2:start:workers": "npx pm2 start ecosystem.config.cjs --only background-workers,ingestion-workers,analytics-workers",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs --env production",
    "pm2:reload": "npx pm2 startOrReload ecosystem.config.cjs --env production",
    "pm2:delete": "npx pm2 delete ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:monit": "npx pm2 monit",
    "pm2:status": "npx pm2 list",
    "lint": "eslint src --ext .ts",
    "lint:queries": "tsx scripts/audit-primarydb-queries.ts",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "stress:memory": "node --expose-gc --import tsx/esm scripts/stress-test-memory.ts",
    "bench:ingestion": "tsx scripts/bench-ingestion-worker.ts",
    "bench:ingestion:matrix": "tsx scripts/run-ingestion-benchmark-matrix.ts",
    "bench:ingestion:compare": "tsx scripts/compare-ingestion-benchmarks.ts",
    "bench:ingestion:matrix:compare": "tsx scripts/compare-ingestion-benchmark-matrices.ts",
    "bench:ingestion:matrix:summary": "tsx scripts/summarize-ingestion-benchmark-matrix.ts",
    "bench:ingestion:http": "tsx scripts/bench-ingestion-http.ts",
    "bench:ingestion:http:provision": "tsx scripts/bench/provision-benchmark-fixture.ts",
    "bench:ingestion:http:fast-regression": "tsx scripts/bench-ingestion-http.ts --mode baseline --duration-seconds 20 --rate 5 --batch-size 10 --profile mixed",
    "explain:ingestion": "tsx scripts/explain-ingestion-writes.ts",
    "explain:ingestion:summary": "tsx scripts/summarize-ingestion-explain.ts",
    "ingestion:db:audit": "tsx scripts/audit-ingestion-db-schema.ts",
    "ingestion:db:runtime": "tsx scripts/diagnose-ingestion-db-runtime.ts",
    "ingestion:db:runtime:summary": "tsx scripts/summarize-ingestion-db-runtime.ts",
    "ingestion:admission:summary": "tsx scripts/summarize-ingestion-admission-profiles.ts",
    "ingestion:worker:summary": "tsx scripts/summarize-ingestion-worker-profiles.ts",
    "ingestion:triage": "tsx scripts/summarize-ingestion-triage.ts",
    "ingestion:test-report": "tsx scripts/run-ingestion-test-report.ts",
    "ingestion:metrics:verify": "tsx scripts/verify-ingestion-metrics-scrape.ts",
    "ingestion:evidence:validate": "tsx scripts/validate-ingestion-evidence-bundle.ts",
    "ingestion:queues:rebuild": "tsx scripts/rebuild-ingest-pgboss-queues.ts",
    "db:schema:run": "tsx scripts/run-modular-schema.ts",
    "db:top-queries": "tsx scripts/db-top-queries.ts",
    "db:explain": "tsx scripts/db-explain.ts",
    "db:pgbouncer:export": "tsx scripts/pgbouncer-exporter.ts",
    "db:schema:run:primary": "tsx scripts/run-modular-schema.ts --only primary",
    "db:schema:run:logdb": "tsx scripts/run-modular-schema.ts --only logdb",
    "db:schema:run:dry": "tsx scripts/run-modular-schema.ts --dry-run",
    "db:schema:run:recreate": "tsx scripts/run-modular-schema.ts --recreate --yes",
    "db:bootstrap": "tsx scripts/bootstrap-modular-db.ts",
    "db:bootstrap:primary": "tsx scripts/bootstrap-modular-db.ts --only primary",
    "db:bootstrap:logdb": "tsx scripts/bootstrap-modular-db.ts --only logdb",
    "db:bootstrap:recreate": "tsx scripts/bootstrap-modular-db.ts --recreate --yes",
    "db:setup:modular": "tsx scripts/bootstrap-modular-db.ts",
    "db:recreate": "tsx scripts/recreate-databases-v2.ts",
    "db:recreate:v2": "tsx scripts/recreate-databases-v2.ts",
    "db:migrate": "tsx scripts/migrate-v2.ts",
    "db:migrate:v2": "tsx scripts/migrate-v2.ts",
    "db:migrate:primary": "tsx scripts/migrate-v2.ts --only primary",
    "db:migrate:logdb": "tsx scripts/migrate-v2.ts --only logdb",
    "db:migration:create": "tsx scripts/create-migration.ts",
    "db:rebuild": "tsx scripts/rebuild-v2.ts",
    "db:rebuild:v2": "tsx scripts/rebuild-v2.ts",
    "db:rebuild:primary": "tsx scripts/rebuild-primary-schema-file.ts",
    "db:rebuild:log": "tsx scripts/rebuild-log-schema-file.ts",
    "db:reconcile:indexes": "tsx scripts/reconcile-db-indexes.ts",
    "db:seed:primary": "tsx scripts/run-primary-seeders.ts",
    "db:seed": "tsx scripts/run-primary-seeders.ts",
    "db:seed:billing": "tsx scripts/seed-billing-plans.ts",
    "billing:preview": "node scripts/generate-billing-preview.cjs",
    "email:preview": "tsx scripts/preview-emails.ts",
    "db:indexes": "tsx scripts/add-indexes.ts",
    "db:truncate:primary": "tsx scripts/truncate-primary-db.ts",
    "db:reset:logdb": "tsx scripts/reset-logdb.ts",
    "db:truncate:logdb:events": "tsx scripts/truncate-logdb-event-tables.ts",
    "db:truncate:all": "tsx scripts/truncate-all-dbs.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clickhouse/client": "^1.18.2",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/passport": "^3.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "@simplewebauthn/server": "^13.3.1",
    "@supabase/server": "^1.5.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.113.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.7",
    "openai": "^6.33.0",
    "openid-client": "^6.8.4",
    "opossum": "^9.0.0",
    "otpauth": "^9.5.0",
    "p-limit": "^7.3.0",
    "p-map": "^7.0.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "svix": "^1.90.0",
    "ts-morph": "^28.0.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/clickhouse": "^11.13.0",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.1",
    "ts-morph": "^28.0.0",
