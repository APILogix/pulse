  "limits": {
    "maxSpansPerTrace": 2000,
    "maxSpanAttributes": 128,
    "maxAttributeLength": 4096,
    "maxPayloadSize": 1048576,
    "maxQueueSize": 10000,
    "maxMemoryMb": "auto",
    "tenantGovernance": {
      "enabled": false,
      "maxTenantsTracked": 1000,
      "quotaPerWindow": 10000,
      "windowDurationMs": 60000,
      "criticalReserve": 100
