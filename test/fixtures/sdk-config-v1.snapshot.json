  "privacy": {
    "capture": {
      "headers": false,
      "body": false,
      "response": false,
      "query": false,
      "cookies": false
    },
    "scrubbing": {
      "enabled": true,
      "headers": [
        "authorization",
        "proxy-authorization",
        "cookie",
        "set-cookie",
        "x-api-key"
      ],
      "fields": [
        "password",
        "secret",
        "token",
        "apiKey",
        "authorization",
        "creditCard",
        "ssn",
        "access_token",
        "refresh_token",
        "client_secret"
