# Connection Settings
# Neon Free Tier (0.25 CU, 100 CU-hrs/month limit):
# - DB_POOL_MIN=0 and LOG_POOL_MIN=0 enable Neon Scale-to-Zero when idle.
# - Idle timeouts set to 15000ms so idle connections release promptly, letting Neon's 5m suspend trigger.
# - LOG_DB_SLOW_QUERY_MS calibrated to 3000ms to avoid false alarms from transcontinental WAN latency.
DB_FAMILY=4
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=15000
LOG_POOL_MAX=10
LOG_POOL_MIN=0
LOG_DB_IDLE_TIMEOUT=15000
LOG_DB_CONNECTION_TIMEOUT=30000
LOG_DB_KEEPALIVE_MS=10000
LOG_DB_SLOW_QUERY_MS=3000

# Ingestion Pipeline Tuning (Sized for 0.25 CU compute limit)
INGESTION_LOG_DB_SYNCHRONOUS_COMMIT=off
INGESTION_WRITE_CONCURRENCY=3
INGESTION_WRITE_POOL_SIZE=5
INGESTION_DB_POOL_SIZE=3

# PGMQ Queue Pooling (Right-sized for Neon Free Tier)
QUEUE_POOL_MAX=5
QUEUE_COMMAND_POOL_MAX=2
QUEUE_POLL_SECONDS=0
