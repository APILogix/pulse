{
  "schema_version": "4.0.0-proposal",
  "catalog_version": 4,
  "status": "design_proposal",
  "currency": "USD",
  "description": "Credit-first billing redesign proposal. Event telemetry and AI use separate prepaid credit pools. Resource, delivery, retention, and security limits are finite and explicit.",
  "list_price_status": "Existing list prices are placeholders for comparison only. Reprice after measured COGS and a finance-approved gross-margin target are available.",
  "feature_entitlement_policy": "Each plan carries the complete 52-key current feature map and 7-key integration map. Free explicitly enables baseline alerting and alert rules so its two per-project rules and 50 daily notifications can be used.",
  "principles": [
    "One weighted monthly event-credit pool covers billable telemetry. Do not impose extra per-signal monthly event quotas.",
    "AI actions debit only the separate AI credit balance; ai_action must not also debit telemetry event credits.",
    "No uncapped postpaid usage. Free is hard-limited; paid plans stop at included credits unless an organization explicitly enables a prepaid pack or approved spend cap.",
    "Organization alert-rule count has no plan quota. Per-project rule limits and finite project counts bound configuration growth.",
    "Alert notifications, integration deliveries, connector instances, and channel creation are separate bounded resources.",
    "Never publish an included allowance or add-on price as profitable until measured storage, query, delivery, and model costs pass the gross-margin gate."
  ],
  "credit_model": {
    "event_pool_key": "quota.monthly_events",
    "event_pool_label": "Monthly event credits",
    "event_credit_reset": "monthly; no rollover; annual subscribers receive the same monthly allowance",
    "event_credit_weights_source": "billing-credits-and-metering.json#/telemetry_event_credit_system.event_credit_weights",
    "weights": {
      "metric": 0.1,
      "log": 0.2,
      "trace": 0.5,
      "span": 0.5,
      "event": 1,
      "error": 1,
      "session": 1.5,
      "crash": 2,
      "replay": 5
    },
    "excluded_event_types": {
      "ai_action": "AI actions debit quota.ai_credits only. Remove the current 10 event-credit weight to prevent double billing."
    },
    "unknown_event_policy": "reject_and_alert_catalog_owners",
    "ai_pool_key": "quota.ai_credits",
    "ai_pool_label": "Monthly AI credits",
    "ai_credit_reset": "monthly; no rollover; annual subscribers receive the same monthly allowance",
    "ai_cost_rules_source": "billing-credits-and-metering.json#/ai_credit_system.active_implementation.credit_rules",
    "ai_action_cost_credits": {
      "failure_only": 2,
      "exact_error_query": 2,
      "single_occurrence": 2,
      "pure_business_event": 2,
      "timeline": 3,
      "slow_request": 3,
      "request_id": 3,
      "recent_history": 3,
      "trace_id": 4,
      "correlation_key": 4,
      "full_investigation": 5
    },
    "exhaustion_behavior": "reserve_before_work; stop new billable work when balance is exhausted; cached/free results follow explicit zero-cost rules; no negative balance",
    "unknown_weights_cost_basis": "Retain documented weights provisionally. Validate payload-size and storage costs against real telemetry before release."
  },
  "pricing_safety": {
    "existing_list_prices_retained_for_modeling": true,
    "free_tier_event_credits": 15000,
    "free_tier_ai_credits": 0,
    "default_overage": "disabled_for_every_tier",
    "paid_exhaustion": "pause ingestion or AI work at allowance; offer an explicit prepaid credit pack; any postpaid spend cap requires customer opt-in",
    "gross_margin_target_percent": null,
    "minimum_cost_inputs_required_before_launch": [
      "P50/P95 stored bytes per weighted event credit, including indexes and replicas",
      "Monthly retained GB and query compute per plan at the proposed retention window",
      "Provider input/output cost per AI credit by model route, including retries and fallbacks",
      "Integration delivery provider cost per destination and retry",
      "Support, egress, backup, and payment processing cost allocation"
    ],
    "pricing_formula": "minimum net price = measured expected monthly COGS / (1 - finance-approved target gross margin); compare plan revenue and every add-on to that floor",
    "unverified_price_flags": [
      "Existing events_10m add-on is $49 per 10,000,000 credits while the metering doc lists $0.50 per 1,000 credits; those imply $49 versus $5,000 for the same volume. Do not ship either rate until one source of truth and measured COGS are approved.",
      "Existing 100K AI credits for $99 cannot be validated against provider cost because per-route cost per credit is not present in the catalog. Keep AI pack checkout disabled until cost-derived pricing is approved."
    ]
  },
  "usage_notifications": {
    "event_and_ai_credit_thresholds_percent": [
      50,
      75,
      90,
      100
    ],
    "daily_delivery_thresholds_percent": [
      80,
      100
    ],
    "channels": [
      "in_app",
      "email",
      "configured_webhook"
    ],
    "behavior_at_hard_limit": "notify_then_pause_billable_usage; never silently accrue postpaid spend"
  },
