{
  "title": "Pulsiv Ingestion Workers",
  "uid": "pulsiv-ingestion-workers",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "pulsiv",
    "ingestion",
    "telemetry"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(ingest_events_inserted_by_type_total, type)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(ingest_jobs_processed_total, queue)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Durable Events/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (type) (rate(ingest_events_inserted_by_type_total{type=~\"$type\"}[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Batches/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (type) (rate(ingest_batches_processed_by_type_total{type=~\"$type\"}[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Payload Bytes/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum by (type) (rate(ingest_batch_bytes_total{type=~\"$type\"}[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Queue Wait p95/p99/p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "max by (quantile, type) (ingest_stage_latency_ms_quantile{stage=\"queue_wait\",quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} p{{quantile}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker and E2E p95/p99/p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "max by (quantile, type) (ingest_processing_latency_ms_quantile{quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} processing p{{quantile}}"
        },
        {
          "expr": "max by (quantile, type) (ingest_e2e_latency_ms_quantile{quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} e2e p{{quantile}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "DB Wait and Query p95/p99/p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "max by (quantile, type) (ingest_stage_latency_ms_quantile{stage=\"dbConnectionWaitMs\",quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} connection wait p{{quantile}}"
        },
        {
          "expr": "max by (quantile, type) (ingest_db_query_duration_ms_quantile{quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} query p{{quantile}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Typed Insert p95/p99/p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "max by (stage, quantile, type) (ingest_stage_latency_ms_quantile{stage=~\"perType\\\\..*\\\\.durationMs\",quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} {{stage}} p{{quantile}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "DB Pool Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum by (pool, state) (ingest_db_pool_connections)",
          "legendFormat": "{{pool}} {{state}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "DB Queries per Batch p95/p99/p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "max by (quantile, type) (ingest_db_queries_per_batch_quantile{quantile=~\"0.95|0.99|0.999\",type=~\"$type\"})",
          "legendFormat": "{{type}} p{{quantile}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Queue Depth and Oldest Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "ingest_queue_depth_ready",
          "legendFormat": "ready"
        },
        {
          "expr": "ingest_queue_depth_deferred",
          "legendFormat": "deferred"
        },
        {
          "expr": "ingest_queue_depth_active",
          "legendFormat": "active"
        },
        {
          "expr": "ingest_queue_oldest_pending_job_age_ms / 1000",
          "legendFormat": "oldest seconds"
        }
      ]
    },
    {
      "id": 10,
      "title": "Retries, Defers, Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by (queue) (rate(ingest_jobs_retried_total{queue=~\"$queue\"}[5m]))",
          "legendFormat": "{{queue}} retries"
        },
        {
          "expr": "sum by (queue) (rate(ingest_events_deferred_total{queue=~\"$queue\"}[5m]))",
          "legendFormat": "{{queue}} deferred events"
        },
        {
          "expr": "sum by (queue) (rate(ingest_events_failed_total{queue=~\"$queue\"}[5m]))",
          "legendFormat": "{{queue}} failed events"
        }
      ]
    },
    {
      "id": 11,
      "title": "Tenant Fairness and Worker Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "sum by (queue, type) (ingest_worker_inflight_jobs{queue=~\"$queue\",type=~\"$type\"}) / clamp_min(sum by (queue, type) (ingest_worker_configured_slots{queue=~\"$queue\",type=~\"$type\"}), 1)",
          "legendFormat": "{{queue}} {{type}} utilization"
        },
        {
          "expr": "sum by (queue, type) (rate(ingest_fairness_starvation_guard_admissions_total{queue=~\"$queue\",type=~\"$type\"}[5m]))",
          "legendFormat": "{{queue}} {{type}} starvation guard"
        }
      ]
    },
    {
      "id": 12,
      "title": "DLQ and Duplicates",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "ingest_dlq_retained_jobs",
          "legendFormat": "retained DLQ"
        },
        {
          "expr": "sum by (queue, type) (rate(ingest_events_duplicate_total{queue=~\"$queue\",type=~\"$type\"}[5m]))",
          "legendFormat": "{{queue}} {{type}} duplicates"
        }
      ]
    }
  ]
}
